---
const categories = ["Tous", "Électronique", "Accessoires", "Audio"];

const produits = [
  { nom: "Montre Connectée Ultima", prix: "25 000 FCFA", categorie: "Électronique", image: "https://images.unsplash.com/photo-1523275335684-37898b6baf30?q=80&w=400&auto=format&fit=crop", badge: "Vedette" },
  { nom: "Casque Bluetooth NeoStudio", prix: "18 000 FCFA", categorie: "Audio", image: "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?q=80&w=400&auto=format&fit=crop", badge: "Nouveau" },
  { nom: "Sac à Dos Tech Protect", prix: "15 000 FCFA", categorie: "Accessoires", image: "https://images.unsplash.com/photo-1553062407-98eeb64c6a62?q=80&w=400&auto=format&fit=crop", badge: "Tendance" },
];

const numeroWhatsapp = "22500000000"; // Remplacer par le numéro client
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Joël Shop | L'Expérience E-Commerce Moderne</title>
    
    <!-- Typographie moderne "Plus Jakarta Sans" -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">

    <style>
      :root {
        --violet-dark: #120924;
        --violet-main: #6d28d9;
        --violet-light: #7c3aed;
        --orange-neon: #ff6b00;
        --orange-hover: #e05e00;
        --bg-light: #f8fafc;
        --card-bg: #ffffff;
        --text-dark: #0f172a;
        --text-muted: #64748b;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: var(--bg-light); color: var(--text-dark); -webkit-font-smoothing: antialiased; }

      /* Top Announcement Bar */
      .announcement { background: linear-gradient(90deg, var(--violet-dark), var(--violet-main)); color: white; text-align: center; padding: 0.5rem 1rem; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.5px; }
      .announcement span { color: var(--orange-neon); }

      /* Header & Navigation */
      header { background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(12px); border-bottom: 1px solid #e2e8f0; position: sticky; top: 0; z-index: 100; }
      .nav-container { max-width: 1200px; margin: 0 auto; padding: 1rem 1.5rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
      
      .logo { font-size: 1.5rem; font-weight: 800; color: var(--violet-dark); text-decoration: none; display: flex; align-items: center; gap: 4px; }
      .logo span { color: var(--orange-neon); }

      .search-bar { display: flex; flex: 1; max-width: 400px; position: relative; }
      .search-bar input { width: 100%; background: #f1f5f9; border: 1px solid transparent; padding: 0.6rem 1rem; border-radius: 99px; font-size: 0.85rem; outline: none; transition: all 0.2s; }
      .search-bar input:focus { border-color: var(--violet-main); background: white; }

      .nav-actions { display: flex; align-items: center; gap: 1rem; }
      .cart-btn { background: var(--violet-dark); color: white; padding: 0.6rem 1.2rem; border-radius: 99px; text-decoration: none; font-size: 0.85rem; font-weight: 700; transition: background 0.2s; }
      .cart-btn:hover { background: var(--violet-main); }

      /* Hero Section */
      .hero { background: radial-gradient(circle at top right, #2e1065, var(--violet-dark)); color: white; padding: 4rem 1.5rem; text-align: center; position: relative; overflow: hidden; }
      .hero::after { content: ''; position: absolute; bottom: -50px; left: 50%; transform: translateX(-50%); width: 300px; height: 100px; background: var(--orange-neon); filter: blur(90px); opacity: 0.5; }
      .hero-title { font-size: 2.5rem; font-weight: 800; line-height: 1.2; margin-bottom: 1rem; letter-spacing: -1px; }
      .hero-title span { background: linear-gradient(135deg, #ff9e59, var(--orange-neon)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
      .hero-subtitle { color: #cbd5e1; font-size: 1.05rem; max-width: 600px; margin: 0 auto; font-weight: 400; }

      /* Main Content & Categories */
      main { max-width: 1200px; margin: 0 auto; padding: 3rem 1.5rem; }
      
      .section-title { font-size: 1.5rem; font-weight: 800; color: var(--violet-dark); margin-bottom: 1.5rem; }
      
      .categories { display: flex; gap: 0.75rem; overflow-x: auto; padding-bottom: 1rem; margin-bottom: 2rem; scrollbar-width: none; }
      .cat-btn { background: white; border: 1px solid #e2e8f0; color: var(--text-muted); padding: 0.6rem 1.4rem; border-radius: 99px; font-weight: 600; font-size: 0.85rem; white-space: nowrap; cursor: pointer; transition: all 0.2s; }
      .cat-btn.active, .cat-btn:hover { background: var(--violet-main); color: white; border-color: var(--violet-main); box-shadow: 0 4px 12px rgba(109, 40, 217, 0.25); }

      /* Product Grid */
      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; }
      .card { background: var(--card-bg); border-radius: 1.25rem; border: 1px solid #e2e8f0; overflow: hidden; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); display: flex; flex-direction: column; justify-content: space-between; }
      .card:hover { transform: translateY(-6px); border-color: rgba(124, 58, 237, 0.3); box-shadow: 0 20px 30px -10px rgba(18, 9, 36, 0.08); }
      
      .card-img-wrap { position: relative; width: 100%; height: 240px; background: #f8fafc; overflow: hidden; }
      .card-img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s; }
      .card:hover .card-img-wrap img { transform: scale(1.05); }
      
      .badge { position: absolute; top: 1rem; left: 1rem; background: rgba(18, 9, 36, 0.85); backdrop-filter: blur(8px); color: var(--orange-neon); font-size: 0.7rem; font-weight: 800; padding: 0.3rem 0.7rem; border-radius: 99px; text-transform: uppercase; letter-spacing: 0.5px; border: 1px solid rgba(255, 107, 0, 0.3); }

      .card-content { padding: 1.5rem; flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
      .card-cat { font-size: 0.75rem; font-weight: 700; color: var(--violet-main); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.4rem; }
      .card-title { font-size: 1.15rem; font-weight: 700; color: var(--text-dark); margin-bottom: 0.5rem; }
      .card-price { font-size: 1.3rem; font-weight: 800; color: var(--violet-dark); margin-bottom: 1.2rem; }

      .btn-whatsapp { display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; background: var(--orange-neon); color: white; border: none; padding: 0.85rem; border-radius: 0.85rem; font-weight: 700; text-decoration: none; font-size: 0.9rem; transition: all 0.2s; box-shadow: 0 4px 14px rgba(255, 107, 0, 0.3); }
      .btn-whatsapp:hover { background: var(--orange-hover); box-shadow: 0 6px 20px rgba(255, 107, 0, 0.45); }

      /* Footer High-End */
      footer { background: var(--violet-dark); color: white; padding: 4rem 1.5rem 2rem; border-top: 3px solid var(--orange-neon); }
      .footer-container { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 2.5rem; margin-bottom: 3rem; }
      
      .footer-brand .logo { color: white; margin-bottom: 1rem; }
      .footer-brand p { color: #94a3b8; font-size: 0.85rem; line-height: 1.6; }
      
      .footer-column h4 { font-size: 0.95rem; font-weight: 700; color: var(--orange-neon); margin-bottom: 1.2rem; text-transform: uppercase; letter-spacing: 0.5px; }
      .footer-column ul { list-style: none; }
      .footer-column ul li { margin-bottom: 0.6rem; }
      .footer-column ul li a { color: #cbd5e1; text-decoration: none; font-size: 0.85rem; transition: color 0.2s; }
      .footer-column ul li a:hover { color: white; }

      .payment-methods { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.8rem; }
      .payment-badge { background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.1); color: #e2e8f0; font-size: 0.75rem; font-weight: 600; padding: 0.4rem 0.8rem; border-radius: 6px; }

      .footer-bottom { max-width: 1200px; margin: 0 auto; padding-top: 2rem; border-top: 1px solid rgba(255, 255, 255, 0.1); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; font-size: 0.8rem; color: #94a3b8; }
      .credits { color: #e2e8f0; font-weight: 600; }
      .credits span { color: var(--orange-neon); }
    </style>
  </head>
  <body>

    <!-- Barre d'annonce -->
    <div class="announcement">
      ⚡ LIVRAISON EXPRESS DISPONIBLE — <span>PAIEMENT À LA LIVRAISON</span>
    </div>

    <!-- En-tête / Navigation -->
    <header>
      <div class="nav-container">
        <a href="#" class="logo">Joël<span>Shop.</span></a>
        
        <div class="search-bar">
          <input type="text" placeholder="Rechercher un produit..." />
        </div>

        <div class="nav-actions">
          <a href="#" class="cart-btn">Panier (0)</a>
        </div>
      </div>
    </header>

    <!-- Section Héro Moderne -->
    <section class="hero">
      <h1 class="hero-title">L'Innovation au Service<br>de votre <span>Style de Vie.</span></h1>
      <p class="hero-subtitle">Produits premium garantis et sélection d'exception au meilleur prix.</p>
    </section>

    <!-- Contenu Principal -->
    <main>
      <h2 class="section-title">Nos Collections</h2>
      
      <!-- Barre de Catégories -->
      <div class="categories">
        {categories.map((cat, index) => (
          <button class={`cat-btn ${index === 0 ? 'active' : ''}`}>{cat}</button>
        ))}
      </div>

      <!-- Grille Produits -->
      <div class="grid">
        {produits.map((p) => {
          const message = encodeURIComponent(`Bonjour Joël Shop, je souhaite commander le produit : ${p.nom} (${p.prix}).`);
          const urlWhatsapp = `https://wa.me/${numeroWhatsapp}?text=${message}`;

          return (
            <div class="card">
              <div>
                <div class="card-img-wrap">
                  <img src={p.image} alt={p.nom} />
                  <span class="badge">{p.badge}</span>
                </div>
                <div class="card-content">
                  <div>
                    <div class="card-cat">{p.categorie}</div>
                    <h3 class="card-title">{p.nom}</h3>
                    <div class="card-price">{p.prix}</div>
                  </div>
                  <a href={urlWhatsapp} target="_blank" class="btn-whatsapp">
                    Commander via WhatsApp
                  </a>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </main>

    <!-- Pied de Page Futuriste & Complet -->
    <footer>
      <div class="footer-container">
        <div class="footer-brand">
          <div class="logo">Joël<span>Shop.</span></div>
          <p>Votre destination e-commerce de référence. Produits certifiés, service client réactif et expédition rapide.</p>
        </div>

        <div class="footer-column">
          <h4>Navigation</h4>
          <ul>
            <li><a href="#">Accueil</a></li>
            <li><a href="#">Toutes les catégories</a></li>
            <li><a href="#">Nouveautés</a></li>
            <li><a href="#">Promotions</a></li>
          </ul>
        </div>

        <div class="footer-column">
          <h4>Aide & Support</h4>
          <ul>
            <li><a href="#">Guide de commande</a></li>
            <li><a href="#">Politique de retour</a></li>
            <li><a href="#">Service Client WhatsApp</a></li>
            <li><a href="#">FAQ</a></li>
          </ul>
        </div>

        <div class="footer-column">
          <h4>Paiements Acceptés</h4>
          <p style="color: #94a3b8; font-size: 0.8rem; margin-bottom: 0.5rem;">Payer en toute sécurité via :</p>
          <div class="payment-methods">
            <span class="payment-badge">Wave</span>
            <span class="payment-badge">Orange</span>
            <span class="payment-badge">MTN</span>
            <span class="payment-badge">Moov</span>
          </div>
        </div>
      </div>

      <div class="footer-bottom">
        <div>&copy; 2026 Joël Shop. Tous droits réservés.</div>
        <div class="credits">Conçu avec passion par <span>Cccreation</span></div>
      </div>
    </footer>

  </body>
</html>
