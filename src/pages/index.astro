---
const categories = ["Tous", "Électronique", "Accessoires", "Audio"];

const produits = [
  { id: 1, nom: "Montre Connectée Ultima", prix: "25 000 FCFA", rawPrix: 25000, categorie: "Électronique", image: "https://images.unsplash.com/photo-1523275335684-37898b6baf30?q=80&w=400&auto=format&fit=crop", badge: "Vedette" },
  { id: 2, nom: "Casque Bluetooth NeoStudio", prix: "18 000 FCFA", rawPrix: 18000, categorie: "Audio", image: "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?q=80&w=400&auto=format&fit=crop", badge: "Nouveau" },
  { id: 3, nom: "Sac à Dos Tech Protect", prix: "15 000 FCFA", rawPrix: 15000, categorie: "Accessoires", image: "https://images.unsplash.com/photo-1553062407-98eeb64c6a62?q=80&w=400&auto=format&fit=crop", badge: "Tendance" },
  { id: 4, nom: "Écouteurs True Wireless", prix: "12 000 FCFA", rawPrix: 12000, categorie: "Audio", image: "https://images.unsplash.com/photo-1590658268037-6bf12165a8df?q=80&w=400&auto=format&fit=crop", badge: "Promo" },
  { id: 5, nom: "Support Téléphone MagSafe", prix: "8 000 FCFA", rawPrix: 8000, categorie: "Accessoires", image: "https://images.unsplash.com/photo-1586105251261-72a756497a11?q=80&w=400&auto=format&fit=crop", badge: "Utile" },
];

const numeroWhatsapp = "22500000000"; // Numéro client
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Joël Shop | L'Expérience E-Commerce Moderne</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">

    <style>
      :root {
        --violet-dark: #120924;
        --violet-main: #6d28d9;
        --orange-neon: #ff6b00;
        --orange-hover: #e05e00;
        --bg-light: #f8fafc;
        --card-bg: #ffffff;
        --text-dark: #0f172a;
        --text-muted: #64748b;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: var(--bg-light); color: var(--text-dark); -webkit-font-smoothing: antialiased; }

      .announcement { background: linear-gradient(90deg, var(--violet-dark), var(--violet-main)); color: white; text-align: center; padding: 0.5rem 1rem; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.5px; }
      .announcement span { color: var(--orange-neon); }

      header { background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(12px); border-bottom: 1px solid #e2e8f0; position: sticky; top: 0; z-index: 100; }
      .nav-container { max-width: 1200px; margin: 0 auto; padding: 1rem 1.5rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
      
      .logo { font-size: 1.5rem; font-weight: 800; color: var(--violet-dark); text-decoration: none; }
      .logo span { color: var(--orange-neon); }

      .search-bar { display: flex; flex: 1; max-width: 400px; }
      .search-bar input { width: 100%; background: #f1f5f9; border: 1px solid transparent; padding: 0.6rem 1rem; border-radius: 99px; font-size: 0.85rem; outline: none; transition: all 0.2s; }
      .search-bar input:focus { border-color: var(--violet-main); background: white; }

      .hero { background: radial-gradient(circle at top right, #2e1065, var(--violet-dark)); color: white; padding: 3.5rem 1.5rem; text-align: center; position: relative; overflow: hidden; }
      .hero-title { font-size: 2.2rem; font-weight: 800; line-height: 1.2; margin-bottom: 0.8rem; }
      .hero-title span { background: linear-gradient(135deg, #ff9e59, var(--orange-neon)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
      .hero-subtitle { color: #cbd5e1; font-size: 1rem; max-width: 600px; margin: 0 auto; }

      main { max-width: 1200px; margin: 0 auto; padding: 2.5rem 1.5rem; }
      .section-title { font-size: 1.4rem; font-weight: 800; color: var(--violet-dark); margin-bottom: 1.2rem; }
      
      .categories { display: flex; gap: 0.75rem; overflow-x: auto; padding-bottom: 1rem; margin-bottom: 2rem; scrollbar-width: none; }
      .cat-btn { background: white; border: 1px solid #e2e8f0; color: var(--text-muted); padding: 0.6rem 1.4rem; border-radius: 99px; font-weight: 600; font-size: 0.85rem; white-space: nowrap; cursor: pointer; transition: all 0.2s; }
      .cat-btn.active, .cat-btn:hover { background: var(--violet-main); color: white; border-color: var(--violet-main); box-shadow: 0 4px 12px rgba(109, 40, 217, 0.25); }

      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; }
      .card { background: var(--card-bg); border-radius: 1.25rem; border: 1px solid #e2e8f0; overflow: hidden; transition: all 0.3s; display: flex; flex-direction: column; justify-content: space-between; }
      .card.hidden { display: none !important; }
      .card:hover { transform: translateY(-4px); border-color: rgba(124, 58, 237, 0.3); box-shadow: 0 15px 25px -5px rgba(18, 9, 36, 0.08); }
      
      .card-img-wrap { position: relative; width: 100%; height: 220px; background: #f8fafc; }
      .card-img-wrap img { width: 100%; height: 100%; object-fit: cover; }
      
      .badge { position: absolute; top: 0.8rem; left: 0.8rem; background: rgba(18, 9, 36, 0.85); backdrop-filter: blur(8px); color: var(--orange-neon); font-size: 0.7rem; font-weight: 800; padding: 0.3rem 0.6rem; border-radius: 99px; text-transform: uppercase; border: 1px solid rgba(255, 107, 0, 0.3); }

      .card-content { padding: 1.25rem; flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
      .card-cat { font-size: 0.75rem; font-weight: 700; color: var(--violet-main); text-transform: uppercase; margin-bottom: 0.3rem; }
      .card-title { font-size: 1.1rem; font-weight: 700; color: var(--text-dark); margin-bottom: 0.4rem; }
      .card-price { font-size: 1.2rem; font-weight: 800; color: var(--violet-dark); margin-bottom: 1rem; }

      .btn-whatsapp { display: flex; align-items: center; justify-content: center; width: 100%; background: var(--orange-neon); color: white; border: none; padding: 0.8rem; border-radius: 0.8rem; font-weight: 700; text-decoration: none; font-size: 0.85rem; transition: all 0.2s; box-shadow: 0 4px 12px rgba(255, 107, 0, 0.25); }
      .btn-whatsapp:hover { background: var(--orange-hover); }

      #no-results { display: none; text-align: center; padding: 3rem; color: var(--text-muted); font-weight: 600; }

      footer { background: var(--violet-dark); color: white; padding: 3rem 1.5rem 1.5rem; border-top: 3px solid var(--orange-neon); margin-top: 3rem; }
      .footer-bottom { max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; font-size: 0.8rem; color: #94a3b8; }
      .credits span { color: var(--orange-neon); font-weight: 700; }
    </style>
  </head>
  <body>

    <div class="announcement">⚡ LIVRAISON EXPRESS — <span>PAIEMENT À LA LIVRAISON</span></div>

    <header>
      <div class="nav-container">
        <a href="#" class="logo">Joël<span>Shop.</span></a>
        <div class="search-bar">
          <input type="text" id="searchInput" placeholder="Rechercher un produit..." />
        </div>
      </div>
    </header>

    <section class="hero">
      <h1 class="hero-title">L'Innovation au Service<br>de votre <span>Style de Vie.</span></h1>
      <p class="hero-subtitle">Produits certifiés et sélection d'exception au meilleur prix.</p>
    </section>

    <main>
      <h2 class="section-title">Nos Collections</h2>
      
      <!-- Boutons de filtrage par catégorie -->
      <div class="categories">
        {categories.map((cat, index) => (
          <button class={`cat-btn ${index === 0 ? 'active' : ''}`} data-category={cat}>{cat}</button>
        ))}
      </div>

      <!-- Grille Produits -->
      <div class="grid" id="productGrid">
        {produits.map((p) => {
          const message = encodeURIComponent(`Bonjour Joël Shop, je souhaite commander : ${p.nom} (${p.prix}).`);
          const urlWhatsapp = `https://wa.me/${numeroWhatsapp}?text=${message}`;

          return (
            <div class="card" data-category={p.categorie} data-name={p.nom.toLowerCase()}>
              <div class="card-img-wrap">
                <img src={p.image} alt={p.nom} />
                <span class="badge">{p.badge}</span>
              </div>
              <div class="card-content">
                <div>
                  <div class="card-cat">{p.categorie}</div>
                  <h3 class="card-title">{p.nom}</h3>
                  <div class="card-price">{p.prix}</div>
                </div>
                <a href={urlWhatsapp} target="_blank" class="btn-whatsapp">
                  Commander sur WhatsApp
                </a>
              </div>
            </div>
          );
        })}
      </div>

      <div id="no-results">Aucun produit ne correspond à votre recherche.</div>
    </main>

    <footer>
      <div class="footer-bottom">
        <div>&copy; 2026 Joël Shop. Tous droits réservés.</div>
        <div class="credits">Conçu avec passion par <span>Cccreation</span></div>
      </div>
    </footer>

    <!-- SCRIPT JS INTERACTIF (Filtrage & Recherche) -->
    <script>
      const buttons = document.querySelectorAll('.cat-btn');
      const cards = document.querySelectorAll('.card');
      const searchInput = document.getElementById('searchInput');
      const noResults = document.getElementById('no-results');

      let currentCategory = 'Tous';
      let searchQuery = '';

      function filterProducts() {
        let visibleCount = 0;

        cards.forEach(card => {
          const category = card.getAttribute('data-category');
          const name = card.getAttribute('data-name');

          const matchesCategory = (currentCategory === 'Tous' || category === currentCategory);
          const matchesSearch = name.includes(searchQuery);

          if (matchesCategory && matchesSearch) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
      }

      // Écouteur sur les boutons de catégories
      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          buttons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          currentCategory = btn.getAttribute('data-category');
          filterProducts();
        });
      });

      // Écouteur sur la barre de recherche
      searchInput?.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
        filterProducts();
      });
    </script>

  </body>
</html>
