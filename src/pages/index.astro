---
const produits = [
  { nom: "Montre Connectée Sport", prix: "25 000 FCFA", image: "https://images.unsplash.com/photo-1523275335684-37898b6baf30?q=80&w=400&auto=format&fit=crop", badge: "Populaire" },
  { nom: "Casque Bluetooth Sans Fil", prix: "18 000 FCFA", image: "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?q=80&w=400&auto=format&fit=crop", badge: "Nouveau" },
  { nom: "Sac à Dos Urbal", prix: "15 000 FCFA", image: "https://images.unsplash.com/photo-1553062407-98eeb64c6a62?q=80&w=400&auto=format&fit=crop", badge: "Promo" },
];

const numeroWhatsapp = "22500000000"; // Remplacer par le numéro du client
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Joël Shop | Boutique Officielle</title>
    <style>
      :root { --primary: #25D366; --dark: #0f172a; --accent: #4f46e5; }
      body { font-family: 'Segoe UI', system-ui, sans-serif; background-color: #f8fafc; margin: 0; color: #334155; }
      
      /* Navigation */
      nav { background: #ffffff; padding: 1.2rem 1.5rem; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 1px 10px rgba(0,0,0,0.05); sticky: top: 0; }
      .logo { font-size: 1.6rem; font-weight: 800; color: var(--dark); tracking: -0.5px; }
      .logo span { color: var(--accent); }
      .badge-nav { background: #e0e7ff; color: var(--accent); padding: 0.4rem 0.8rem; border-radius: 20px; font-weight: 600; font-size: 0.85rem; }

      /* Hero Banner */
      header { text-align: center; padding: 3.5rem 1rem 2.5rem; max-width: 800px; margin: 0 auto; }
      h1 { font-size: 2.5rem; font-weight: 900; color: var(--dark); margin-bottom: 0.8rem; line-height: 1.2; }
      .tagline { color: #64748b; font-size: 1.15rem; margin-bottom: 1.5rem; }

      /* Grille Produits */
      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; max-width: 1100px; margin: 0 auto; padding: 0 1.5rem 4rem; }
      .card { background: white; border-radius: 1.25rem; overflow: hidden; border: 1px solid #e2e8f0; transition: transform 0.2s, box-shadow 0.2s; position: relative; }
      .card:hover { transform: translateY(-4px); box-shadow: 0 12px 20px rgba(0,0,0,0.08); }
      .card-image { position: relative; width: 100%; height: 220px; }
      .card img { width: 100%; height: 100%; object-fit: cover; }
      .badge { position: absolute; top: 12px; left: 12px; background: rgba(15, 23, 42, 0.85); color: white; padding: 0.25rem 0.6rem; border-radius: 6px; font-size: 0.75rem; font-weight: 600; backdrop-filter: blur(4px); }
      
      .card-content { padding: 1.25rem; }
      .card h3 { font-size: 1.2rem; font-weight: 700; color: var(--dark); margin: 0 0 0.5rem 0; }
      .price { color: var(--accent); font-size: 1.25rem; font-weight: 800; margin-bottom: 1rem; }
      
      /* Bouton WhatsApp */
      .btn-whatsapp { display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; background: var(--primary); color: white; border: none; padding: 0.8rem; border-radius: 0.75rem; font-weight: 700; text-decoration: none; font-size: 0.95rem; box-sizing: border-box; }
      .btn-whatsapp:hover { background: #20ba5a; }
    </style>
  </head>
  <body>
    
    <nav>
      <div class="logo">Joël<span>Shop.</span></div>
      <span class="badge-nav">Livraison Rapide 🇨🇮</span>
    </nav>

    <header>
      <h1>Commandez en un clic,<br>payez à la livraison.</h1>
      <p class="tagline">Découvrez notre sélection exclusive d'articles de qualité.</p>
    </header>

    <main class="grid">
      {produits.map((p) => {
        const message = encodeURIComponent(`Bonjour Joël Shop, je souhaite commander : ${p.nom} au prix de ${p.prix}.`);
        const urlWhatsapp = `https://wa.me/${numeroWhatsapp}?text=${message}`;
        
        return (
          <div class="card">
            <div class="card-image">
              <img src={p.image} alt={p.nom} />
              <span class="badge">{p.badge}</span>
            </div>
            <div class="card-content">
              <h3>{p.nom}</h3>
              <div class="price">{p.prix}</div>
              <a href={urlWhatsapp} target="_blank" class="btn-whatsapp">
                Commander sur WhatsApp
              </a>
            </div>
          </div>
        );
      })}
    </main>

  </body>
</html>
